# Where the order email is delivered. For now, the restaurant's inbox.
RESTAURANT_EMAIL=morlaajay38@gmail.com

# SMTP credentials used to SEND the order email. This needs a real
# sending account - options:
#   - Gmail SMTP: smtp.gmail.com, port 587, an "App Password" (requires
#     2-Step Verification on the Google account - your normal password
#     will not work here).
#   - A transactional email provider's free tier (e.g. Resend, SendGrid)
#     usually gives you SMTP credentials directly, with less setup
#     friction than Gmail's app-password flow.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-sending-address@gmail.com

PORT=3001
